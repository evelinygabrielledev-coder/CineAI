# Copie este arquivo para ".env" e coloque suas chaves.

# TMDB — catálogo de filmes (importar_tmdb.py)
# Crie em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_tmdb_aqui

# OMDb — Rotten Tomatoes, IMDb e Metacritic (importar_avaliacoes.py)
# Crie em: https://www.omdbapi.com/apikey.aspx  (ative pelo link do e-mail)
OMDB_API_KEY=sua_chave_omdb_aqui
